#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

OFFLINE_MODE=false
LANG_CODE="${WHISPER_LANG:-auto}"
CONTINUOUS=false
PARTIAL=false
COPY_CLIP=false
OUT_FILE=""
DURATION=""
MODEL="${WHISPER_MODEL:-$HOME/.local/share/whisper/ggml-small-q5_1.bin}"
WHISPER_BIN="${WHISPER_BIN:-$(command -v whisper-cli 2>/dev/null || echo "${PREFIX:-/data/data/com.termux/files/usr}/bin/whisper-cli")}"
THREADS="${WHISPER_THREADS:-6}"
PROG_NAME="$(basename "$0")"

if [ "$PROG_NAME" = "vdict" ]; then
  OFFLINE_MODE=true
fi

show_help() {
  cat <<EOF
Usage: $PROG_NAME [options]

Capture speech from the Android microphone and output text to Termux.
  - 'vdict'             runs 100% offline via whisper.cpp (default: auto language detection)
  - 'dictate --offline' runs the same offline whisper.cpp mode
  - 'dictate'           uses Android system speech recognition via Termux:API

Options:
  --offline        Run 100% offline transcription via whisper.cpp
  -l <lang>        ISO-639-1 language code for offline mode (default: auto; e.g. en, es, fr, de, it, ja, zh)
  -s <seconds>     Record for a fixed duration in offline mode (non-interactive / script-friendly)
  -c               Continuous mode (utterance by utterance until Ctrl+C)
  -p               Stream partial results in real time (Android Termux:API mode)
  -k               Copy transcribed text to the Android clipboard
  -o <file>        Append transcribed text to a file
  -m <model>       Path to an alternative GGML Whisper model file
  --test           Verify Termux:API, whisper-cli, ffmpeg, and model availability
  -h, --help       Show this help message

Temporary files:
  Offline mode records temporary audio in \$TMPDIR/vdict.XXXXXX and removes it automatically on exit.

Environment variables:
  WHISPER_LANG     Default offline language code (default: auto)
  WHISPER_MODEL    Default GGML model path (default: ~/.local/share/whisper/ggml-small-q5_1.bin)
  WHISPER_THREADS  CPU threads for whisper-cli (default: 6)

Documentation:
  See README.md and .agents/skills/termux-android-mic-adb/SKILL.md.
EOF
}

test_env() {
  local ok=0
  echo "Checking Termux:API..." >&2
  if command -v termux-battery-status >/dev/null 2>&1 && timeout 5 termux-battery-status >/dev/null 2>&1; then
    echo "  [OK] Termux:API responding" >&2
  else
    echo "  [ERROR] Termux:API did not respond (verify app installation, permissions, and battery settings)" >&2
    ok=1
  fi

  echo "Checking offline transcription stack (whisper.cpp)..." >&2
  if [ -x "$WHISPER_BIN" ] || command -v "$WHISPER_BIN" >/dev/null 2>&1; then
    echo "  [OK] whisper-cli: $WHISPER_BIN" >&2
  else
    echo "  [ERROR] whisper-cli not found: $WHISPER_BIN" >&2
    ok=1
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    echo "  [OK] ffmpeg: $(command -v ffmpeg)" >&2
  else
    echo "  [ERROR] ffmpeg not found" >&2
    ok=1
  fi

  if [ -s "$MODEL" ]; then
    echo "  [OK] model: $MODEL ($(du -h "$MODEL" | awk '{print $1}'))" >&2
  else
    echo "  [ERROR] model missing: $MODEL" >&2
    ok=1
  fi

  return $ok
}

while [ $# -gt 0 ]; do
  case "$1" in
    --offline) OFFLINE_MODE=true ;;
    -l|--lang)
      shift
      [ $# -gt 0 ] || { echo "Error: -l requires a language code (e.g. auto, en, es, fr, de)." >&2; exit 1; }
      LANG_CODE="$1"
      OFFLINE_MODE=true
      ;;
    -s|--seconds)
      shift
      [ $# -gt 0 ] || { echo "Error: -s requires a positive integer duration in seconds." >&2; exit 1; }
      if ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: -s requires a positive integer (got '$1')." >&2
        exit 1
      fi
      DURATION="$1"
      OFFLINE_MODE=true
      ;;
    -c) CONTINUOUS=true ;;
    -p) PARTIAL=true ;;
    -k) COPY_CLIP=true ;;
    -o)
      shift
      [ $# -gt 0 ] || { echo "Error: -o requires an output file path." >&2; exit 1; }
      OUT_FILE="$1"
      ;;
    -m|--model)
      shift
      [ $# -gt 0 ] || { echo "Error: -m requires a Whisper model path." >&2; exit 1; }
      MODEL="$1"
      ;;
    --test)
      test_env
      exit $?
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      echo "Unknown option: $1 (use -h for help)" >&2
      exit 1
      ;;
  esac
  shift
done

emit_text() {
  local text="$1"
  if [ -n "$text" ]; then
    printf '%s\n' "$text"
    if [ -n "$OUT_FILE" ]; then
      printf '%s\n' "$text" >> "$OUT_FILE"
    fi
    if [ "$COPY_CLIP" = true ]; then
      if ! printf '%s' "$text" | timeout 4 termux-clipboard-set 2>/dev/null; then
        echo "Warning: failed to copy transcript to clipboard." >&2
      fi
    fi
  fi
}

run_once_system() {
  if ! command -v termux-speech-to-text >/dev/null 2>&1; then
    echo "Error: termux-speech-to-text not found (install termux-api)." >&2
    return 1
  fi

  if [ "$PARTIAL" = true ]; then
    if [ -n "$OUT_FILE" ]; then
      termux-speech-to-text -p | tee -a "$OUT_FILE"
    else
      termux-speech-to-text -p
    fi
    return $?
  fi

  local text=""
  local rc=0
  text="$(termux-speech-to-text)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "Error: termux-speech-to-text failed with exit code $rc." >&2
    return "$rc"
  fi
  emit_text "$text"
}

run_once_offline() {
  if [ ! -x "$WHISPER_BIN" ]; then
    echo "Error: whisper-cli not found at $WHISPER_BIN" >&2
    return 1
  fi
  if [ ! -s "$MODEL" ]; then
    echo "Error: Whisper model not found at $MODEL" >&2
    return 1
  fi
  if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "Error: ffmpeg not found." >&2
    return 1
  fi
  if ! command -v termux-microphone-record >/dev/null 2>&1; then
    echo "Error: termux-microphone-record not found (install termux-api)." >&2
    return 1
  fi

  local workdir
  workdir="$(mktemp -d "${TMPDIR:-/data/data/com.termux/files/usr/tmp}/vdict.XXXXXX")"
  local raw_m4a="$workdir/rec.m4a"
  local wav_16k="$workdir/rec.wav"
  local rec_pid=""

  cleanup_rec() {
    if [ -n "${rec_pid:-}" ]; then
      kill "$rec_pid" 2>/dev/null || true
    fi
    timeout 3 termux-microphone-record -q >/dev/null 2>&1 || true
    rm -rf "$workdir"
  }
  trap cleanup_rec RETURN INT TERM

  timeout 2 termux-microphone-record -q >/dev/null 2>&1 || true

  local max_dur="${DURATION:-180}"
  termux-microphone-record -f "$raw_m4a" -l "$max_dur" >/dev/null 2>&1 &
  rec_pid=$!

  sleep 0.4

  if [ -n "$DURATION" ]; then
    echo "[REC] Recording offline (lang=$LANG_CODE) for ${DURATION}s..." >&2
    sleep "$DURATION"
  else
    echo "[REC] Recording offline (lang=$LANG_CODE)... Speak now and press ENTER to transcribe (Ctrl+C to cancel)." >&2
    IFS= read -r _ || true
  fi

  timeout 3 termux-microphone-record -q >/dev/null 2>&1 || true
  kill "$rec_pid" 2>/dev/null || true
  wait "$rec_pid" 2>/dev/null || true
  rec_pid=""

  local tries=0
  local prev_sz=-1
  local cur_sz=0
  while [ "$tries" -lt 15 ]; do
    if [ -f "$raw_m4a" ]; then
      cur_sz=$(wc -c < "$raw_m4a" 2>/dev/null || echo 0)
      if [ "$cur_sz" -gt 100 ] && [ "$cur_sz" -eq "$prev_sz" ]; then
        break
      fi
      prev_sz="$cur_sz"
    fi
    sleep 0.15
    tries=$((tries + 1))
  done

  if [ ! -s "$raw_m4a" ]; then
    echo "Error: no audio captured (verify Termux:API microphone permission)." >&2
    return 1
  fi

  echo "[STT] Transcribing (lang=$LANG_CODE)..." >&2
  if ! ffmpeg -nostdin -loglevel error -y -i "$raw_m4a" -ar 16000 -ac 1 -c:a pcm_s16le "$wav_16k"; then
    echo "Error: ffmpeg audio conversion failed." >&2
    return 1
  fi

  local raw_out=""
  local w_rc=0
  raw_out="$("$WHISPER_BIN" -m "$MODEL" -l "$LANG_CODE" -t "$THREADS" -nt --no-prints -f "$wav_16k" 2>/dev/null)" || w_rc=$?
  if [ "$w_rc" -ne 0 ]; then
    echo "Error: whisper-cli failed with exit code $w_rc." >&2
    return "$w_rc"
  fi

  local clean_text
  clean_text="$(printf '%s\n' "$raw_out" \
    | sed -E 's/\[BLANK_AUDIO\]//g; s/^[[:space:]]+//; s/[[:space:]]+$//' \
    | awk 'NF' \
    | paste -sd ' ' -)"

  emit_text "$clean_text"
}

if [ "$CONTINUOUS" = true ]; then
  if [ "$OFFLINE_MODE" = true ]; then
    echo "Continuous offline dictation active (lang=$LANG_CODE). Press Ctrl+C to stop." >&2
  else
    echo "Continuous dictation active. Speak into the microphone (Ctrl+C to stop)..." >&2
  fi
  trap 'echo "" >&2; exit 0' INT TERM
  while true; do
    if [ "$OFFLINE_MODE" = true ]; then
      run_once_offline
    else
      run_once_system
    fi
  done
else
  if [ "$OFFLINE_MODE" = true ]; then
    run_once_offline
  else
    run_once_system
  fi
fi
