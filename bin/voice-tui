#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

TARGET_PANE="${1:-}"
LANG_CODE="${2:-${WHISPER_LANG:-auto}}"

if [ -z "$TARGET_PANE" ]; then
  echo "Usage: voice-tui <tmux_pane_id> [lang]" >&2
  exit 1
fi

# Strictly validate tmux pane ID format (%<digits>) to prevent command injection
if ! [[ "$TARGET_PANE" =~ ^%[0-9]+$ ]]; then
  echo "Error: invalid tmux pane id '$TARGET_PANE' (expected format: %<digits>)." >&2
  exit 2
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "Error: tmux is required." >&2
  exit 1
fi

if ! tmux display-message -p -t "$TARGET_PANE" '#{pane_id}' >/dev/null 2>&1; then
  echo "Error: tmux target pane '$TARGET_PANE' is no longer available." >&2
  exit 1
fi

DICTATE_BIN="$(command -v dictate 2>/dev/null || echo "${PREFIX:-/data/data/com.termux/files/usr}/bin/dictate")"
if [ ! -x "$DICTATE_BIN" ]; then
  echo "Error: dictate executable not found at $DICTATE_BIN" >&2
  exit 1
fi

printf '\033[1;36m=== Offline Voice Dictation (%s) -> TUI ===\033[0m\n\n' "$LANG_CODE"

TEXT=""
RC=0
TEXT="$("$DICTATE_BIN" --offline -l "$LANG_CODE")" || RC=$?

if [ "$RC" -ne 0 ]; then
  tmux display-message "VOICE: transcription failed (exit $RC)" 2>/dev/null || true
  exit "$RC"
fi

if [ -z "$TEXT" ]; then
  tmux display-message "VOICE: no speech detected" 2>/dev/null || true
  exit 0
fi

# Save to Android clipboard as backup (non-blocking)
if command -v termux-clipboard-set >/dev/null 2>&1; then
  printf '%s' "$TEXT" | timeout 3 termux-clipboard-set >/dev/null 2>&1 || true
fi

# Paste into the validated target pane right after the popup closes (without submitting ENTER)
printf '%s' "$TEXT" | tmux load-buffer -b voice_tui -
tmux run-shell -b "sleep 0.08 && tmux paste-buffer -d -p -b voice_tui -t $TARGET_PANE"

PREVIEW="${TEXT:0:60}"
[ "${#TEXT}" -gt 60 ] && PREVIEW="${PREVIEW}..."
tmux display-message "VOICE inserted: $PREVIEW" 2>/dev/null || true
